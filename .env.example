# Copy to .env before `docker compose up`
DIVEGUARD_PORT=8734
DIVEGUARD_WAL_DIR=/data/wal
DIVEGUARD_MAVLINK2REST_URL=http://host.docker.internal:6040
DIVEGUARD_ALERT_SEVERITY=4
DIVEGUARD_LOG_LEVEL=INFO
# 1 = enable POST /v1/simulate (dev/bench only, keep 0 in the field)
DIVEGUARD_DEV=0
# ALSA capture device for the I2S hydrophone
DIVEGUARD_ALSA_DEVICE=default
# ZMQ endpoint of the C++ DSP core
DIVEGUARD_DSP_ENDPOINT=ipc:///tmp/diveguard_dsp.ipc
